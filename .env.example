# ---- database -------------------------------------------------------------
RADREPORT_DATABASE_URL=postgresql+psycopg://radreport:radreport@localhost:5433/radreport
# Used by the DB-backed test suite. Unset => those tests skip.
RADREPORT_TEST_DATABASE_URL=postgresql+psycopg://radreport:radreport@localhost:5433/radreport_test

# ---- object storage (S3-compatible; SSE-KMS in real deployments) ----------
RADREPORT_STORAGE__BUCKET=radreport-audio
RADREPORT_STORAGE__ENDPOINT_URL=http://localhost:9000
RADREPORT_STORAGE__ACCESS_KEY_ID=radreport
RADREPORT_STORAGE__SECRET_ACCESS_KEY=radreport123
RADREPORT_STORAGE__REGION=us-east-1
# Leave blank for MinIO; set to a KMS key ARN in AWS.
RADREPORT_STORAGE__SSE_KMS_KEY_ID=

# ---- lab sign-in ---------------------------------------------------------
# Signs lab users' access tokens. Required outside local/test/development, at
# least 32 random characters: python -c 'import secrets; print(secrets.token_urlsafe(48))'
RADREPORT_LAB_AUTH__TOKEN_SECRET=

# ---- admin panel ---------------------------------------------------------
# Extra origins allowed to send admin writes, when the public hostname differs
# from the one the app sees behind a proxy. JSON list.
# RADREPORT_TRUSTED_ORIGINS=["https://admin.example.com"]

# ---- providers ------------------------------------------------------------
# NOT prefixed, and not read as settings. The admin panel records which
# variable holds each provider's key (`model_provider.api_key_env_var`) and the
# server reads it from the environment at call time — so a second Anthropic
# account is a second variable here plus a second provider in the admin panel, with
# no code change. Add whatever names you reference there.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=

# ---- observability --------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- public demo ----------------------------------------------------------
# Logins listed on the login page's "Test credentials" tab; `make seed` creates
# them. Leave unset in any real deployment — unset means the tab is not shown.
# Keep role "support" (read-only): a public product_admin can reset the others.
# RADREPORT_DEMO_ACCOUNTS=[{"label":"Recruiter demo","email":"demo@radreport.local","password":"try-radreport-demo","role":"support"}]

# ---- database pool --------------------------------------------------------
# Per worker. Keep WORKERS x (POOL_SIZE + MAX_OVERFLOW) under Postgres
# max_connections, or put PgBouncer in front and set PGBOUNCER=true.
# RADREPORT_DB__POOL_SIZE=30
# RADREPORT_DB__MAX_OVERFLOW=10
# RADREPORT_DB__POOL_TIMEOUT_SECONDS=10
# RADREPORT_DB__SLOW_QUERY_MS=100
# RADREPORT_DB__ECHO=false
# RADREPORT_DB__PGBOUNCER=false

# ---- shared cache -----------------------------------------------------------
# Redis for the cache every worker shares (lab config, roles, model assignments,
# admin sessions). Unset: each worker caches in memory with short TTLs.
# RADREPORT_REDIS_URL=redis://localhost:6379/0

# ---- domain events ------------------------------------------------------------
# postgres (default): the relay applies events to in-process consumers.
# kafka: the relay produces to topics; `docker compose --profile kafka up -d`.
# RADREPORT_EVENTS__BUS=postgres
# RADREPORT_EVENTS__KAFKA_BOOTSTRAP=localhost:9092
