# ---- database -------------------------------------------------------------
RADREPORT_DATABASE_URL=postgresql+psycopg://radreport:radreport@localhost:5433/radreport
# Used by the DB-backed test suite. Unset => those tests skip.
RADREPORT_TEST_DATABASE_URL=postgresql+psycopg://radreport:radreport@localhost:5433/radreport_test

# ---- object storage (S3-compatible; SSE-KMS in real deployments) ----------
# No endpoint, no keys and nothing in the AWS credential chain: the app still runs, and
# audio upload and playback answer 503 (listed under "fallbacks" on /health).
RADREPORT_STORAGE__BUCKET=radreport-audio
RADREPORT_STORAGE__ENDPOINT_URL=http://localhost:9000
RADREPORT_STORAGE__ACCESS_KEY_ID=radreport
RADREPORT_STORAGE__SECRET_ACCESS_KEY=radreport123
RADREPORT_STORAGE__REGION=us-east-1
# Leave blank for MinIO; set to a KMS key ARN in AWS.
RADREPORT_STORAGE__SSE_KMS_KEY_ID=

# ---- lab sign-in ---------------------------------------------------------
# Signs lab users' access tokens. Required outside local/test/development, at
# least 32 random characters: python -c 'import secrets; print(secrets.token_urlsafe(48))'
RADREPORT_LAB_AUTH__TOKEN_SECRET=

# ---- admin panel ---------------------------------------------------------
# Extra origins allowed to send admin writes, when the public hostname differs
# from the one the app sees behind a proxy. JSON list.
# RADREPORT_TRUSTED_ORIGINS=["https://admin.example.com"]

# ---- providers ------------------------------------------------------------
# NOT prefixed, and not read as settings. The admin panel records which
# variable holds each provider's key (`model_provider.api_key_env_var`) and the
# server reads it from the environment at call time — so a second Anthropic
# account is a second variable here plus a second provider in the admin panel, with
# no code change. Add whatever names you reference there.
ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
# The template model server, when started with a key (vLLM --api-key); named on its provider in the admin panel.
TEMPLATE_MODEL_API_KEY=

# ---- terminology and translation ------------------------------------------
# Also unprefixed. RadLex lookups through BioPortal; blank = local synonym set only.
BIOPORTAL_API_KEY=
# Google Cloud Translation v2 for unknown Hindi words; also needs
# languages.online_translation on in System settings. Blank = bundled dictionary only.
GOOGLE_TRANSLATE_API_KEY=

# ---- observability --------------------------------------------------------
# Prometheus scrape token: /metrics needs `Authorization: Bearer <token>`.
# Unset => /metrics answers only in local/test/development.
RADREPORT_OBSERVABILITY__METRICS_TOKEN=
# Error reports (Sentry free tier). Bodies, cookies, messages and locals are scrubbed.
RADREPORT_OBSERVABILITY__SENTRY_DSN=
# Tracing turns on with the standard OpenTelemetry variables, e.g. local Jaeger:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# or Grafana Cloud's OTLP gateway, with its auth header:
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-<zone>.grafana.net/otlp
#   OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20<base64 instance:token>
# Multi-worker runs share metrics through this folder; `make run` sets it.
#   PROMETHEUS_MULTIPROC_DIR=.metrics
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- public demo ----------------------------------------------------------
# Logins listed on the login page's "Test credentials" tab; `make seed` creates
# them. Leave unset in any real deployment — unset means the tab is not shown.
# Keep role "support" (read-only): a public product_admin can reset the others.
# RADREPORT_DEMO_ACCOUNTS=[{"label":"Recruiter demo","email":"demo@radreport.local","password":"try-radreport-demo","role":"support"}]

# ---- database pool --------------------------------------------------------
# Per worker. Keep WORKERS x (POOL_SIZE + MAX_OVERFLOW) under Postgres
# max_connections, or put PgBouncer in front and set PGBOUNCER=true.
# Requests use the async engine and the threaded routes and workers the sync
# one; both are sized by these.
# RADREPORT_DB__POOL_SIZE=30
# RADREPORT_DB__MAX_OVERFLOW=10
# RADREPORT_DB__POOL_TIMEOUT_SECONDS=10
# RADREPORT_DB__SLOW_QUERY_MS=100
# RADREPORT_DB__ECHO=false
# RADREPORT_DB__PGBOUNCER=false
# PgBouncer's admin console for the /admin/pools dashboard (a stats_users role).
# Unset: RADREPORT_DATABASE_URL with the database swapped for "pgbouncer".
# RADREPORT_DB__PGBOUNCER_ADMIN_URL=postgresql://radreport_app_login:...@127.0.0.1:6432/pgbouncer

# ---- shared cache -----------------------------------------------------------
# Redis for the cache every worker shares (lab config, roles, model assignments,
# admin sessions). Unset: each worker caches in memory with short TTLs.
# RADREPORT_REDIS_URL=redis://localhost:6379/0
# Upstash (hosted demo): rediss://default:<password>@<host>.upstash.io:6379

# ---- domain events ------------------------------------------------------------
# postgres (default): the relay applies events to in-process consumers.
# kafka: the relay produces to topics; `docker compose --profile kafka up -d`.
# Kafka chosen but unreachable or missing credentials: the relay falls back to postgres
# (listed under "fallbacks" on /health) and `consume` exits with nothing to do.
# RADREPORT_EVENTS__BUS=postgres
# RADREPORT_EVENTS__KAFKA_BOOTSTRAP=localhost:9092
# A hosted broker: TLS and SASL. Confluent Cloud: SASL_SSL + PLAIN, the API key
# and secret as username and password. Redpanda Cloud, MSK (SCRAM), Aiven:
# SASL_SSL + SCRAM-SHA-256 or -512. CA_LOCATION only when the system store
# does not trust the broker's certificate.
# RADREPORT_EVENTS__KAFKA_SECURITY_PROTOCOL=SASL_SSL
# RADREPORT_EVENTS__KAFKA_SASL_MECHANISM=PLAIN
# RADREPORT_EVENTS__KAFKA_USERNAME=
# RADREPORT_EVENTS__KAFKA_PASSWORD=
# RADREPORT_EVENTS__KAFKA_CA_LOCATION=

# ---- read replica -------------------------------------------------------------
# Dashboards, cost views, lists and exports read from here; unset, from the primary.
# Reads go back to the primary while the replica lags more than MAX_LAG_SECONDS,
# and for READ_YOUR_WRITES_SECONDS after a browser writes.
# RADREPORT_DB__REPLICA_URL=postgresql+psycopg://radreport_app_login:...@replica:5432/radreport
# RADREPORT_DB__REPLICA_MAX_LAG_SECONDS=10
# RADREPORT_DB__READ_YOUR_WRITES_SECONDS=10

# ---- first-start seed -------------------------------------------------------
# On start the API seeds a database with no labs: model catalog, product admin
# admin@radreport.local, the demo logins above and a demo lab. Any lab => skipped.
# Run it by hand with: python -m radreport.db.first_seed
# RADREPORT_SEED_ON_START=true
# Password for that admin; unset => no password (set one with make admin-password).
RADREPORT_SEED_ADMIN_PASSWORD=
