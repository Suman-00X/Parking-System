    <route id="admin.lab.onboarding.page" method="GET" path="/admin/labs/{tenant_id}/onboarding" rate-limit="admin-read">
      <allow role="product_admin"/>
      <allow role="support"/>
    </route>
    <route id="admin.lab.onboarding.roster" method="POST" path="/admin/labs/{tenant_id}/onboarding/roster" rate-limit="admin-upload" max-body-bytes="52428800">
